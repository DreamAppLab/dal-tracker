rules_version = '2';

// DAL Mission Control — Cloud Storage security rules.
// Deny by default; only the allowlisted admin with a VERIFIED email may read
// or write, and only under the known folders, with size and type limits.
//
// KEEP THE ALLOWLIST IN SYNC with api/_lib/allowlist.js and firestore.rules.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email.lower() in ['lab@dreamapplab.com']
          || request.auth.uid in []
        );
    }

    // Deletes are allowed (request.resource == null); uploads are size-capped
    // and limited to images, PDFs and Office documents.
    function okUpload(maxMb) {
      return request.resource == null
        || (request.resource.size < maxMb * 1024 * 1024
            && (request.resource.contentType.matches('image/.*')
                || request.resource.contentType in [
                  'application/pdf',
                  'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                ]));
    }

    match /appLogos/{appId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && okUpload(5);
    }

    match /projectLogos/{projectId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && okUpload(5);
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && okUpload(25);
    }

    match /vault/{projectId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && okUpload(25);
    }

    match /blackbox/{projectId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && okUpload(25);
    }

    match /expenses/{expenseId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && okUpload(10);
    }

    // Anything not matched above is denied.
  }
}
